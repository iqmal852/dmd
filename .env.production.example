# ─────────────────────────────────────────────────────────────────────────
# Production .env template — see docs/DEPLOYMENT.md.
#
# Copy to `.env.production` on the server (that filename is gitignored —
# never commit real secrets) and fill in every value marked SECRET.
# Everything else is a config choice, safe to see in a code review.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME="MySpatial Digital Monument Dossier"
APP_ENV=production
APP_KEY=                          # SECRET — generate with `php artisan key:generate --show`, paste here
APP_DEBUG=false
APP_URL=https://dossier.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE="Asia/Kuala_Lumpur"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging (M9.4) — JSON, one object per line, request_id on every entry ──
LOG_CHANNEL=json
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# ── Database — PostgreSQL only (plan/01-architecture.md ADR-003) ───────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1                 # or the managed Postgres host
DB_PORT=5432
DB_DATABASE=batu_production
DB_USERNAME=batu_production       # SECRET (credential, not just an identifier)
DB_PASSWORD=                      # SECRET
DB_SSLMODE=require                # production DB traffic should not be sslmode=prefer

# ── Single admin user — seeded once via AdminUserSeeder, then unused ───────
# See "First deploy" below. Rotate afterwards with `php artisan batu:admin-password`.
ADMIN_NAME="MySpatial Admin"
ADMIN_EMAIL=admin@myspatial.com.my
ADMIN_PASSWORD=                   # SECRET — one-time seed value only, rotate immediately after first deploy

# ── Dossier: the QR domain and access model ────────────────────────────────
# ⚠ READ THIS BEFORE CHANGING EITHER OF THE NEXT TWO KEYS ⚠
# DOSSIER_BASE_URL and DOSSIER_ROUTE_PREFIX are baked into every printed QR
# plate. Changing either after plates are in the field breaks every one of
# them. If a change is unavoidable, you MUST add a permanent redirect from
# the old prefix/domain to the new one and keep it forever — see "The QR
# domain warning" in docs/DEPLOYMENT.md.
DOSSIER_BASE_URL=https://dossier.example.com
DOSSIER_ROUTE_PREFIX=d

# public | password — see docs/DEPLOYMENT.md "Flipping access mode"
DOSSIER_ACCESS_MODE=public
DOSSIER_ACCESS_PASSWORD=          # SECRET — only used when DOSSIER_ACCESS_MODE=password
DOSSIER_UNLOCK_TTL=720
DOSSIER_UNLOCK_THROTTLE=5
DOSSIER_DOWNLOAD_THROTTLE=30

# ── QR generation ───────────────────────────────────────────────────────────
QR_SIZE=512
QR_MARGIN=16
QR_ERROR_CORRECTION=high
QR_FORMAT=png
QR_LOGO_PATH=

# ── Map tiles ───────────────────────────────────────────────────────────────
MAP_DEFAULT_ZOOM=17
MAP_MAX_ZOOM=19

# ── Branding ─────────────────────────────────────────────────────────────────
BRAND_OPERATOR=MySpatial
BRAND_CLIENT=PLUS
BRAND_TITLE="Digital Monument Dossier"

# ── As-built downloads: audit logging ───────────────────────────────────────
DOWNLOAD_LOG_ENABLED=true
DOWNLOAD_LOG_RETENTION_DAYS=365

# ── Backups (M9.4) — point this at an OFF-SITE disk, not `local` ───────────
# `local` here would put backups on the same disk as what they protect
# against — see docs/DEPLOYMENT.md "Backup and restore". Wiring an S3 (or
# equivalent) disk needs league/flysystem-aws-s3-v3, a new Composer
# dependency — get that approved and add the disk to config/filesystems.php
# before going live; `local` is only acceptable as a placeholder.
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_KEEP_DAYS=30

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true         # requires APP_URL to be https, which it is above
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Cache / queue — both `database`, deliberately (see App\Services\StationCache) ─
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail — only used for framework-internal notifications, no app feature depends on it ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Error tracking (M9.4) — NOT wired up yet ────────────────────────────────
# Requires a new Composer dependency (sentry/sentry-laravel or equivalent),
# which needs approval per CLAUDE.md before install. Once approved:
#   composer require sentry/sentry-laravel
#   php artisan sentry:publish --dsn=<dsn>
# and tag releases to the deploy SHA (see docs/DEPLOYMENT.md).
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_RELEASE=                  # set to the deploy SHA in the deploy script

VITE_APP_NAME="${APP_NAME}"
